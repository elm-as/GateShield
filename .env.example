# Adresse d'écoute du reverse-proxy GateShield
GATESHIELD_LISTEN_ADDR=:8080

# Cible amont (upstream) vers laquelle relayer le trafic autorisé
GATESHIELD_UPSTREAM_URL=http://127.0.0.1:9000

# Politique Token Bucket par adresse IP cliente
GATESHIELD_RATE_PER_SEC=10
GATESHIELD_BURST_CAPACITY=20

# Limite maximale du corps de requête entrant en octets (1 Mio par défaut)
GATESHIELD_MAX_BODY_BYTES=1048576
